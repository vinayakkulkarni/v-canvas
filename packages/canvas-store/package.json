{
  "name": "@vinayakkulkarni/canvas-store",
  "version": "0.0.10",
  "description": "DSCVR Canvas store for using within your awesome Vue apps",
  "keywords": [
    "Canvas App",
    "Canvas Store",
    "DSCVR-Canvas",
    "Vue Canvas",
    "Vue DSCVR Canvas",
    "Vue.js"
  ],
  "homepage": "https://v-canvas.vinayakkulkarni.dev",
  "bugs": {
    "url": "https://github.com/vinayakkulkarni/v-canvas/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinayakkulkarni/v-canvas.git",
    "directory": "packages/canvas-store"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "release": "release-it"
  },
  "dependencies": {
    "@dscvr-one/canvas-client-sdk": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
