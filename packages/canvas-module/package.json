{
  "name": "@vinayakkulkarni/canvas-module",
  "version": "0.0.10",
  "description": "DSCVR Canvas module for your awesome Nuxt app(s)",
  "keywords": [
    "Canvas",
    "DSCVR Canvas",
    "DSCVR Canvas Store",
    "Nuxt Canvas",
    "Nuxt Canvas Module",
    "Nuxt DSCVR Canvas Module",
    "Nuxt.js"
  ],
  "homepage": "https://v-canvas.vinayakkulkarni.dev",
  "bugs": {
    "url": "https://github.com/vinayakkulkarni/v-canvas/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinayakkulkarni/v-canvas.git",
    "directory": "packages/canvas-module"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "prepare:types": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "typecheck": "pnpm run prepare:types && vue-tsc --noEmit",
    "test": "vp test run",
    "release": "release-it"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@vinayakkulkarni/canvas-store": "workspace:^",
    "defu": "^6.1.7"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  }
}
